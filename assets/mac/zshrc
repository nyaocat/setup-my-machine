
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH

  source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  autoload -Uz compinit
  compinit
fi

if type mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

PROMPT="
%n@%m:%d
%# "

alias l='eza --git --group-directories-first -l --time-style long-iso'
alias code='open -a "Visual Studio Code"'
alias claude-sub='CLAUDE_SECURESTORAGE_CONFIG_DIR="$HOME/.claude-sub-auth" claude'

export HISTFILE=${HOME}/.zsh_history
export HISTSIZE=100000
export SAVEHIST=10000000
setopt hist_ignore_dups
setopt hist_ignore_space
setopt EXTENDED_HISTORY
setopt share_history
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_verify
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt hist_no_store
setopt hist_expand
setopt inc_append_history
bindkey "^S" history-incremental-search-forward


source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


zstyle ':completion:*' menu select=2


export PATH="/opt/homebrew/opt/libpq/bin/:$HOME/.local/bin:$PATH"

# https://github.com/rails/rails/issues/38560
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

eval "$(zoxide init zsh)"

# fzf: Ctrl-T (ファイル) / Alt-C (ディレクトリ) / ** 補完。Ctrl-R は atuin に譲る
if type fzf &>/dev/null; then
  source <(fzf --zsh)
  if type fd &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
  if type bat &>/dev/null; then
    export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always {}'"
  fi
fi

# atuin: Ctrl-R の履歴検索。fzf の後に読み込んで Ctrl-R を確実に上書きする
if type atuin &>/dev/null; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi
